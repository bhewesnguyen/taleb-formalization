--- /dev/null
+++ b/Taleb_Lean_Repairs/scripts/FableInventory.lean
@@ -0,0 +1,140 @@
+import Lean
+import AuditRepairs
+
+/-!
+# Environment-based declaration inventory
+
+Independent cross-check for `scripts/verify.py`, whose declaration
+discovery is a line regex over `AuditRepairs/*.lean`. This script asks
+the Lean environment itself for **every** constant whose defining module
+belongs to this project and records, for each one: kind, module, whether
+Lean regards the name as an internal detail (`_private`, `match_`,
+`_proof_`, equation lemmas, ...), whether it is registered as an
+instance, whether it is a Batteries `alias`, whether Lean generated it,
+and its axiom closure (`Lean.collectAxioms`). The axiom closure is
+collected **before** any visibility or provenance filtering, so a
+`private` or otherwise internally named declaration containing `sorry`
+is reported like any other constant.
+
+Provenance ("generated by Lean") is decided from Lean's own bookkeeping,
+not from a namespace prefix: constructors and recursors by constant
+kind, structure projections by `Environment.isProjectionFn`, auxiliary
+recursors (`casesOn`, `recOn`, `brecOn`, ...) by `isAuxRecursor`,
+`noConfusion` by `isNoConfusion`, and the remaining auto-generated
+theorems and definitions (`mk.inj`, `mk.injEq`, `mk.sizeOf_spec`,
+`noConfusionType`, `ctorIdx`, `mk.noConfusion`) by the absence of a
+declaration range, which every user-written declaration has.
+
+Run from the project root after `lake build`:
+
+    lake env lean scripts/FableInventory.lean > inventory.json
+
+The output is a single JSON document. Exit code is nonzero only if Lean
+fails to elaborate this file.
+-/
+
+set_option autoImplicit false
+
+open Lean Meta
+
+namespace FableInventory
+
+def projectModuleRoots : List String := ["AuditRepairs", "Proofs", "AuditVerification"]
+
+def isProjectModule (m : Name) : Bool :=
+  let s := m.toString
+  projectModuleRoots.any fun root => s == root || s.startsWith (root ++ ".")
+
+def kindOf : ConstantInfo → String
+  | .thmInfo _ => "theorem"
+  | .defnInfo _ => "def"
+  | .opaqueInfo _ => "opaque"
+  | .axiomInfo _ => "axiom"
+  | .inductInfo _ => "inductive"
+  | .ctorInfo _ => "constructor"
+  | .recInfo _ => "recursor"
+  | .quotInfo _ => "quot"
+
+structure Row where
+  name : String
+  kind : String
+  module : String
+  /-- `Name.isInternalDetail`: private names, `match_`/`proof_` auxiliaries,
+  equation lemmas, `_simp` lemmas, ... These are still axiom-checked. -/
+  isInternal : Bool
+  isInstance : Bool
+  aliasOf : Option String
+  /-- True when Lean generated the constant (see module docstring). -/
+  generated : Bool
+  /-- Which provenance rule fired, for review: "constructor", "recursor",
+  "projection", "auxRecursor", "noConfusion", "noDeclarationRange", or "". -/
+  generatedBy : String
+  hasDeclarationRange : Bool
+  axioms : Array String
+  /-- Pretty-printed type; omitted (empty) for internal constants. -/
+  type : String
+  deriving ToJson
+
+def aliasTarget (n : Name) : MetaM (Option String) := do
+  match ← Batteries.Tactic.Alias.getAliasInfo n with
+  | some info => return some info.name.toString
+  | none => return none
+
+def moduleOf (env : Environment) (n : Name) : Option Name :=
+  match env.getModuleIdxFor? n with
+  | some idx => env.header.moduleNames[idx.toNat]?
+  | none => none
+
+/-- Provenance classification from Lean's own bookkeeping. Returns the rule
+name, or `""` for user-written constants. -/
+def generatedRule (env : Environment) (n : Name) (cinfo : ConstantInfo) (hasRange : Bool) : String :=
+  match cinfo with
+  | .ctorInfo _ => "constructor"
+  | .recInfo _ => "recursor"
+  | _ =>
+    if env.isProjectionFn n then "projection"
+    else if isAuxRecursor env n then "auxRecursor"
+    else if isNoConfusion env n then "noConfusion"
+    else if !hasRange then "noDeclarationRange"
+    else ""
+
+def run : MetaM Unit := do
+  let env ← getEnv
+  let mut rows : Array Row := #[]
+  let projectNames := env.constants.fold (init := #[]) fun acc n _ =>
+    match moduleOf env n with
+    | some m => if isProjectModule m then acc.push (n, m) else acc
+    | none => acc
+  for (n, m) in projectNames.qsort (fun a b => a.1.toString < b.1.toString) do
+    let some cinfo := env.find? n | pure ()
+    -- Axiom closure first, for every constant, before any filtering.
+    let axs ← collectAxioms n
+    let internal := n.isInternalDetail
+    let hasRange := (← findDeclarationRanges? n).isSome
+    let rule := generatedRule env n cinfo hasRange
+    let ty ← if internal then pure "" else
+      withOptions (fun o => (o.setBool `pp.proofs false).setBool `pp.fullNames true) do
+        return toString (← ppExpr cinfo.type)
+    rows := rows.push {
+      name := n.toString, kind := kindOf cinfo, module := m.toString,
+      isInternal := internal, isInstance := isInstanceCore env n,
+      aliasOf := (← aliasTarget n),
+      generated := !rule.isEmpty, generatedBy := rule, hasDeclarationRange := hasRange,
+      axioms := (axs.qsort (fun a b => a.toString < b.toString)).map (·.toString),
+      type := ty }
+  let importedProjectModules := env.header.moduleNames.filter isProjectModule
+  let json := Json.mkObj [
+    ("lean_version", Json.str Lean.versionString),
+    ("project_module_roots", toJson projectModuleRoots),
+    ("imported_project_modules",
+      toJson ((importedProjectModules.qsort (fun a b => a.toString < b.toString)).map (·.toString))),
+    ("constant_count", toJson rows.size),
+    ("internal_count", toJson (rows.filter (·.isInternal)).size),
+    ("generated_count", toJson (rows.filter (·.generated)).size),
+    ("axiom_kind_constants", toJson ((rows.filter (·.kind == "axiom")).map (·.name))),
+    ("constants", toJson rows)]
+  IO.println json.pretty
+
+end FableInventory
+
+#eval FableInventory.run
