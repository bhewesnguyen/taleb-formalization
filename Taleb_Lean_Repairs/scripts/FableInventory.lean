import Lean
import AuditRepairs

/-!
# Environment-based declaration inventory

Independent cross-check for `scripts/verify.py`, whose declaration
discovery is a line regex over `AuditRepairs/*.lean`. This script asks
the Lean environment itself: every constant whose defining module
belongs to this project is listed with its kind, its module, whether it
is registered as an instance, whether it is a Batteries `alias`, its
axiom closure, and its pretty-printed type. Internal auxiliary
constants (`_private`, `match_`, `proof_`, equation lemmas, ...) are
counted but not listed.

Run from the project root after `lake build`:

    lake env lean scripts/FableInventory.lean > inventory.json

The output is a single JSON document. Exit code is nonzero only if
Lean fails to elaborate this file.
-/

set_option autoImplicit false

open Lean Meta

namespace FableInventory

def projectModuleRoots : List String := ["AuditRepairs", "Proofs", "AuditVerification"]

def isProjectModule (m : Name) : Bool :=
  let s := m.toString
  projectModuleRoots.any fun root => s == root || s.startsWith (root ++ ".")

def kindOf : ConstantInfo → String
  | .thmInfo _ => "theorem"
  | .defnInfo _ => "def"
  | .opaqueInfo _ => "opaque"
  | .axiomInfo _ => "axiom"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "constructor"
  | .recInfo _ => "recursor"
  | .quotInfo _ => "quot"

structure Row where
  name : String
  kind : String
  module : String
  isInstance : Bool
  aliasOf : Option String
  /-- True when the constant was generated by a project `structure`/`inductive`
  declaration (projections, `mk.injEq`, `rec`, `casesOn`, ...), i.e. its parent
  namespace is a project inductive type. Such constants are not user-written
  proofs and are therefore not expected in `AuditVerification.lean`. -/
  generatedByInductive : Bool
  axioms : Array String
  type : String
  deriving ToJson

def aliasTarget (n : Name) : MetaM (Option String) := do
  match ← Batteries.Tactic.Alias.getAliasInfo n with
  | some info => return some info.name.toString
  | none => return none

def moduleOf (env : Environment) (n : Name) : Option Name :=
  match env.getModuleIdxFor? n with
  | some idx => env.header.moduleNames[idx.toNat]?
  | none => none

/-- Is `n` the parent namespace of a project-defined inductive type? -/
def isProjectInductive (env : Environment) (n : Name) : Bool :=
  match env.find? n, moduleOf env n with
  | some (.inductInfo _), some m => isProjectModule m
  | _, _ => false

def run : MetaM Unit := do
  let env ← getEnv
  let mut rows : Array Row := #[]
  let mut internalCount : Nat := 0
  let mut internalNames : Array String := #[]
  -- Collect only project constants first; sorting the whole Mathlib name
  -- space by string would dominate the run time.
  let projectNames := env.constants.fold (init := #[]) fun acc n _ =>
    match moduleOf env n with
    | some m => if isProjectModule m then acc.push (n, m) else acc
    | none => acc
  for (n, m) in projectNames.qsort (fun a b => a.1.toString < b.1.toString) do
    if n.isInternalDetail then
      internalCount := internalCount + 1
      internalNames := internalNames.push n.toString
    else
      let some cinfo := env.find? n | pure ()
      let axs ← collectAxioms n
      let ty ← withOptions (fun o => (o.setBool `pp.proofs false).setBool `pp.fullNames true) do
        return toString (← ppExpr cinfo.type)
      let generated := isProjectInductive env n.getPrefix ||
        isProjectInductive env n.getPrefix.getPrefix
      rows := rows.push {
        name := n.toString, kind := kindOf cinfo, module := m.toString,
        isInstance := isInstanceCore env n, aliasOf := (← aliasTarget n),
        generatedByInductive := generated && !(kindOf cinfo == "inductive"),
        axioms := (axs.qsort (fun a b => a.toString < b.toString)).map (·.toString),
        type := ty }
  let json := Json.mkObj [
    ("lean_version", Json.str Lean.versionString),
    ("project_module_roots", toJson projectModuleRoots),
    ("listed_count", toJson rows.size),
    ("internal_auxiliary_count", toJson internalCount),
    ("internal_auxiliary_names", toJson internalNames),
    ("declarations", toJson rows)]
  IO.println json.pretty

end FableInventory

#eval FableInventory.run
